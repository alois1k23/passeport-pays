# Copiez ce fichier en .env (jamais commité) ou définissez ces variables chez votre hébergeur.
PORT=3000
# Adresse publique du site (sert aux redirections de paiement et aux webhooks).
URL_PUBLIQUE=https://comptoir.example.ch
# Fichier de la base SQLite (à placer sur un disque persistant et à sauvegarder).
BASE_DE_DONNEES=/data/comptoir.db
NODE_ENV=production

# Paiements réels (TWINT + cartes) via Stripe. Sans clé : paiement simulé (désactivé en production).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook « Connect » : ventes et état des comptes Stripe des boutiques (chaque boutique encaisse sur son propre compte)
STRIPE_CONNECT_WEBHOOK_SECRET=

# Fournisseur de démonstration : délai avant expédition simulée (ms, négatif = jamais).
DEMO_DELAI_EXPEDITION_MS=120000
# Journaliser aussi chaque e-mail (destinataire, sujet) dans la console. N'empêche pas l'envoi.
LOG_EMAILS=

# E-mails réels (sinon : file d'attente seulement). Adresse d'envoi vérifiée chez le service.
EMAIL_EXPEDITEUR=Comptoir <ne-pas-repondre@comptoir.example.ch>
BREVO_API_KEY=
# ou
POSTMARK_TOKEN=

# Abonnement Comptoir payé avant l'accès (oui par défaut ; « non » pour un usage interne sans facturation).
# Avec Stripe : Checkout en mode abonnement (cartes ; Stripe ne propose pas TWINT pour les paiements récurrents).
ABONNEMENT_OBLIGATOIRE=oui

# Produits stars : signaux de demande rafraîchis toutes les 6 heures.
# Google Trends via SerpApi (facultatif) : évolution des recherches par pays.
SERPAPI_KEY=
TENDANCES_REQUETES_MAX=30
# Export JSON d'un outil d'analyse ou de relevés de meilleures ventes : [{ "id" ou "nom", "evolution", "niveau", "pays" }]
TENDANCES_FICHIER=
# Les ventes Comptoir d'un produit ne sont prises en compte qu'à partir de ce nombre de boutiques (confidentialité ; 3 au minimum, une valeur plus basse est ignorée).
TENDANCES_MIN_BOUTIQUES=3
TENDANCES_INTERVALLE_MS=21600000
# Ventes observées sur Comptoir : recalcul local toutes les 15 minutes (et à la consultation si plus ancien).
TENDANCES_VENTES_INTERVALLE_MS=900000
TENDANCES_VENTES_AGE_MS=900000

# Limites de débit publiques (commandes 30, codes promo 40, newsletter 20, avis 20 par adresse et par quart d'heure).
# Facteur multiplicateur : 1 en production ; plus élevé pour des tests de charge depuis une seule adresse.
LIMITES_FACTEUR=1

# Essais de connexion autorisés par adresse IP et par quart d'heure.
LIMITE_ESSAIS=10

# Identité de l'hébergeur, affichée dans les mentions légales des boutiques (obligatoire en France, loi LCEN) :
# nom, adresse et téléphone de l'exploitant de la plateforme ou de son hébergeur.
# HEBERGEUR=Comptoir Sàrl, rue de l'Exemple 1, 1003 Lausanne, +41 21 000 00 00

# Identité de l'exploitant de la plateforme, affichée sur /mentions-legales, /confidentialite et /conditions.
# EXPLOITANT_NOM=Comptoir Sàrl
# EXPLOITANT_ADRESSE=Rue de l'Exemple 1, 1003 Lausanne
# EXPLOITANT_EMAIL=contact@exemple.ch
# EXPLOITANT_IDE=CHE-000.000.000
# N° de TVA de l'exploitant, seulement s'il est assujetti (les prix des formules deviennent « hors TVA ») :
# EXPLOITANT_TVA=CHE-000.000.000 TVA

# Adresses des proxys de confiance (par défaut la machine elle-même : Caddy en local). Derrière eux, l'adresse du client
# est lue dans X-Forwarded-For pour les limites d'essais. Séparées par des virgules.
# PROXY_DE_CONFIANCE=127.0.0.1,::1

# Limites et fréquences (valeurs par défaut)
# LIMITE_COMMANDES=30
# EMAIL_INTERVALLE_MS=30000
# SOCIAL_INTERVALLE_MS=60000
# AUTO_INTERVALLE_MS=300000
# Tests uniquement, jamais en production : domaine activé sans contrôle DNS ni TXT.
# DOMAINES_SANS_VERIFICATION=1

# Sécurité des comptes
# Clé de chiffrement des secrets de double authentification (32 octets en hexadécimal : openssl rand -hex 32).
# Sans elle, une clé est créée et gardée dans la base (moins sûr : base volée = secrets lisibles).
# SECRET_CHIFFREMENT=
# Refuser les mots de passe parus dans des fuites connues (Have I Been Pwned, anonymat k : seuls 5 caractères
# de l'empreinte SHA-1 quittent le serveur). Actif par défaut en production ; « non » pour le couper.
# VERIFIER_FUITES=oui

# Webhooks marchands : intervalle d'envoi de la file (ms)
# WEBHOOK_INTERVALLE_MS=15000

# Clés d'accès (passkeys) : domaine auquel elles sont liées. Par défaut, le domaine de URL_PUBLIQUE.
# À ne pas changer une fois des clés créées (elles ne fonctionneraient plus).
# WEBAUTHN_RP_ID=comptoir.ch

# Sauvegardes chiffrées (recommandé) : 64 caractères hexadécimaux (openssl rand -hex 32), gardés HORS du serveur.
# Les copies quotidiennes deviennent comptoir-AAAA-MM-JJ.db.enc (AES-256-GCM), illisibles sans la clé.
# Restaurer : SAUVEGARDE_CLE=… node server/server.js --restaurer comptoir-AAAA-MM-JJ.db.enc nouvelle.db
# SAUVEGARDE_CLE=
